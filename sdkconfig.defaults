# ============================================================
# ESP-IDF 工程配置（PlatformIO espidf 框架）
# - 控制台/日志走 SuperMini 内置 USB-Serial-JTAG（插 USB 可见）
# - OTA 双分区（ota_0/ota_1 + otadata，v31）：支持 WiFi 无线升级
#   merged.bin 布局不变：0x0 bootloader / 0x8000 partitions / 0x10000 app(ota_0)
# ============================================================

# USB-Serial-JTAG 作为系统控制台（printf 输出到 USB）
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# v32.29：主任务看门狗 —— 主循环一旦卡死（RMT/printf/NVS 任一处）就重启，
# 不再需要现场拔电。8 秒足够覆盖 OTA 写入等长操作。
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=8

# 开启帧指针：崩溃时输出完整 backtrace（便于定位问题）
CONFIG_ESP_SYSTEM_USE_FRAME_POINTER=y

# OTA 双分区表（见 partitions_ota.csv）
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_ota.csv"

# 4MB flash（SuperMini）
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# WiFi 热点（AP）功能（v21：RGBled / 12345678 + Web 设置）
CONFIG_ESP_WIFI_ENABLED=y

# WiFi + 蓝牙软件共存（C3 单射频分时；缺此项蓝牙可能起不来）
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# 蓝牙 BLE（v32：NUS 透传调参，SpeedyBee App 连飞控）
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
